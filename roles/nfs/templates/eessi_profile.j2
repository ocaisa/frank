# Ansible managed: eessi login profile.
# ssh runs a login shell, which reads this file instead of ~/.bashrc.
# Source the shared .bashrc so the proxy environment and the EESSI (lmod)
# initialisation apply to logins as well as nested interactive shells.
if [ -n "$BASH_VERSION" ]; then
  if [ -f ~/.bashrc ]; then
    . ~/.bashrc
  fi
fi
