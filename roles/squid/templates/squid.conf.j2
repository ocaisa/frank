# Ansible managed: squid proxy for the EESSI cluster.
# No upstream proxy is configured; the head reaches the internet directly via
# Wi-Fi and NATs the private LAN.
#
# Any node on the LAN may proxy to any destination (CVMFS stratum-1 mirrors
# on .cern.ch/.opensciencegrid.org, EESSI, git, APT, ...); everything else is
# denied. CVMFS additionally falls back to DIRECT, so it survives proxy outages.

acl cluster_net src {{ cluster_net }}/{{ cluster_netmask_prefix }}

http_port 127.0.0.1:3128
http_port {{ squid_listen }}:3128

# Only allow access from our local machines
http_access allow cluster_net
http_access allow localhost

# Finally, deny all other access to this proxy
http_access deny all

collapsed_forwarding on
minimum_expiry_time 0
maximum_object_size 1024 MB

# proxy memory cache
cache_mem 512 MB
maximum_object_size_in_memory 128 KB
# 20 GB disk cache
cache_dir ufs {{ squid_cache_dir }} 20000 16 256
