# Ansible managed: NFS exports for the EESSI/Slurm cluster.
# NFSv4 needs a single pseudo-root (fsid=0). We make the export root (/nfs) the
# pseudo-root and export it read-write, so every path under it (e.g. /home) is
# writable. /var/spool/slurm is deliberately NOT under /nfs, so it stays local
# and unique to each node.
{{ nfs_export_root }} {{ cluster_net }}/{{ cluster_netmask_prefix }}({{ nfs_options }},fsid=0)

