# Ansible managed: squid proxy for the EESSI cluster.
# No upstream proxy is configured; the head reaches the internet directly via
# Wi-Fi and NATs the private LAN.

acl cluster_net src {{ cluster_net }}/{{ cluster_netmask_prefix }}

acl Safe_ports port 80 443 3128
acl SSL_ports port 443
acl CONNECT method CONNECT
acl purge method PURGE

http_port 127.0.0.1:3128
http_port {{ squid_listen }}:3128

cache_dir ufs {{ squid_cache_dir }} 1024 16 256

access_log /var/log/squid/access.log squid
cache_log /var/log/squid/cache.log

http_access deny purge
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow localhost
http_access allow cluster_net
http_access deny all

cache_mgr eessi@local
visible_hostname {{ head_hostname }}

maximum_object_size 512000 KB
maximum_object_size_in_memory 51200 KB

refresh_pattern ^ftp: 1440 20% 10080
refresh_pattern ^gopher: 1440 0% 1440
refresh_pattern -i (^http.*?/wp-admin/uploads/|.\.(pgp|gpg|sig)) 0 0% 1
refresh_pattern . 0 40% 43200

request_header_access Via deny all
request_header_access X-Forwarded-For deny all
forwarded_for off
via off

include /etc/squid/conf.d/*.conf
