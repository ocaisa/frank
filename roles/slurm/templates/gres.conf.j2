# Ansible managed: explicit GRES definition for the Jetson Orin GPU.
# Native AutoDetect (nvml/nvidia) works on Jetson (Tegra). The GPU can be autodetected; File= is required for
# gpu-type GRES; /dev/nvgpu is the Tegra GPU device node.
AutoDetect=on
Name={{ gres_types }} File={{ gres_file | default('/dev/nvgpu') }} Count={{ gpus | default(1) }}
